#!/usr/bin/env bash
# Git runs this before each commit once core.hooksPath points here
# (scripts/setup-worktree.sh sets it). It checks only the staged files,
# so it stays quick: formatting and lint through scripts/check-staged.sh,
# then spelling (typos) and secrets (gitleaks) when they're installed.
# CI still runs everything. Files are checked as they are on disk,
# unstaged edits included.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Added, copied, modified or renamed: deleted files have nothing to check.
# Symlinks are skipped: Prettier refuses one named on its command line,
# and what they point to is checked as its own file.
files=()
while IFS= read -r -d '' file; do
  [[ -L "$file" ]] || files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
((${#files[@]})) || exit 0

failed=0
if [[ -x scripts/check-staged.sh ]]; then
  scripts/check-staged.sh "${files[@]}" || failed=1
fi
if command -v typos >/dev/null 2>&1; then
  typos --force-exclude -- "${files[@]}" || failed=1
fi
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || failed=1
fi

if ((failed)); then
  echo "pre-commit: fix the above, stage it and commit again" >&2
fi
exit "$failed"
