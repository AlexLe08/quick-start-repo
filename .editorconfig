# Editor basics for every file type. Prettier, ruff and dotnet format read
# the indent from here too; google-java-format always uses 2, the default.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,cs}]
indent_size = 4

[Makefile]
indent_style = tab

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
