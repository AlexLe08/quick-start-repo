{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh secret *)",
      "Bash(gh ruleset *)",
      "Bash(gh repo delete *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(git config --global*)",
      "Bash(git config * --global*)",
      "Bash(docker compose down *-v*)",
      "Bash(docker-compose down *-v*)"
    ],
    "ask": ["Bash(git push * v*)", "Bash(git push * --tags*)"]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
