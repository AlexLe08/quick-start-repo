{
  "dotnet.defaultSolution": "{{PASCAL_NAME}}.slnx",
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": true
  },
  "files.exclude": {
